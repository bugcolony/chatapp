COMPOSE_PROJECT_NAME=chat-dev

APP_DOMAIN=localhost
TRAEFIK_STATIC_CONFIG=./docker/edge/traefik.dev.yml
TRAEFIK_DOCKER_API_VERSION=1.44
TRAEFIK_ROUTER_ENTRYPOINTS=web
TRAEFIK_ROUTER_TLS=false
TRAEFIK_CERT_RESOLVER=default
TRAEFIK_ACME_EMAIL=ops@example.com
TRAEFIK_DASHBOARD_EXPOSE_PORT=8080

APP_NAME=Chat
APP_ENV=local
APP_KEY=base64:change-me
APP_DEBUG=true
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=local-password

SESSION_DRIVER=redis
SESSION_CONNECTION=ops
SESSION_STORE=redis
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_LIFETIME=43200
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,::1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

CACHE_STORE=redis
REDIS_CACHE_CONNECTION=ops_cache
REDIS_CACHE_LOCK_CONNECTION=ops
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=ops
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

REDIS_CLIENT=phpredis
REDIS_PREFIX=
REDIS_OPS_PASSWORD=local-ops-password
REDIS_OPS_DB=0
REDIS_OPS_CACHE_DB=1
REDIS_REALTIME_PASSWORD=local-realtime-password
REDIS_REALTIME_DB=0
REDIS_CHANNEL=messages.created

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=chat
AWS_SECRET_ACCESS_KEY=local-rustfs-secret
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=chat-dev
AWS_ENDPOINT=http://rustfs:9000
AWS_URL=http://localhost:9000/chat-dev
AWS_USE_PATH_STYLE_ENDPOINT=true

NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_APP_URL=
NUXT_PUBLIC_WS_URL=ws://localhost/ws
NUXT_AUTH_TIMEOUT=10000

WS_PORT=8080

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Chat

HORIZON_ALLOWED_EMAILS=
HORIZON_PATH=horizon
TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope
TELESCOPE_SLOW_QUERY_THRESHOLD=100

LOCAL_UID=1000
LOCAL_GID=1000

POSTGRES_EXPOSE_PORT=5432
REDIS_OPS_EXPOSE_PORT=6379
REDIS_REALTIME_EXPOSE_PORT=6380
RUSTFS_API_EXPOSE_PORT=9000
RUSTFS_CONSOLE_EXPOSE_PORT=9001
MAILPIT_SMTP_EXPOSE_PORT=1025
MAILPIT_UI_EXPOSE_PORT=8025
PGADMIN_EXPOSE_PORT=5050
REDISINSIGHT_EXPOSE_PORT=5540
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=local-password

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
