COMPOSE_PROJECT_NAME=chat-prod

APP_DOMAIN=chat.example.com
TRAEFIK_DOCKER_API_VERSION=1.44
TRAEFIK_ROUTER_ENTRYPOINTS=websecure
TRAEFIK_ROUTER_TLS=true
TRAEFIK_CERT_RESOLVER=default
TRAEFIK_ACME_EMAIL=change-me@example.com

APP_NAME=Chat
APP_ENV=production
APP_KEY=change-me
APP_DEBUG=false
APP_URL=https://chat.example.com
APP_FRONTEND_URL=https://chat.example.com
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_CONNECTION=ops
SESSION_STORE=redis
SESSION_DOMAIN=chat.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=43200
SANCTUM_STATEFUL_DOMAINS=chat.example.com
CORS_ALLOWED_ORIGINS=https://chat.example.com

CACHE_STORE=redis
REDIS_CACHE_CONNECTION=ops_cache
REDIS_CACHE_LOCK_CONNECTION=ops
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=ops
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

REDIS_CLIENT=phpredis
REDIS_PREFIX=
REDIS_OPS_PASSWORD=change-me
REDIS_OPS_DB=0
REDIS_OPS_CACHE_DB=1
REDIS_REALTIME_PASSWORD=change-me
REDIS_REALTIME_DB=0
REDIS_CHANNEL=messages.created

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=chat-prod
AWS_ENDPOINT=http://rustfs:9000
AWS_URL=https://chat.example.com/storage
AWS_USE_PATH_STYLE_ENDPOINT=true

NUXT_PUBLIC_API_BASE=https://chat.example.com
NUXT_PUBLIC_APP_URL=https://chat.example.com
NUXT_PUBLIC_WS_URL=wss://chat.example.com/ws
NUXT_AUTH_TIMEOUT=10000

WS_PORT=8080

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Chat

HORIZON_ALLOWED_EMAILS=
HORIZON_PATH=horizon
TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope
TELESCOPE_SLOW_QUERY_THRESHOLD=100

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
